        "Authorization": "Bearer <MCP_TOKEN>"
      },
      "enabled": true
    },
    "lightrag": {
      "type": "remote",
      "url": "https://76-13-214-57.sslip.io/lightrag/mcp",
      "headers": {
        "Authorization": "Bearer <MCP_TOKEN>"
      },
      "enabled": true
    }
  }
}